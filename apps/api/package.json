{
  "name": "@opsflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker/main.ts",
    "build": "tsc",
    "migrate": "node-pg-migrate up -m migrations",
    "migrate:down": "node-pg-migrate down -m migrations",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/static": "8.0.3",
    "argon2": "0.41.1",
    "fastify": "5.1.0",
    "jose": "5.9.6",
    "node-pg-migrate": "7.8.0",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/pg": "8.11.10",
    "pino-pretty": "13.0.0",
    "vitest": "2.1.8"
  }
}
